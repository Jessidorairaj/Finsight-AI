# ==============================================================================
# FinSight AI — Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Placeholders only. NEVER commit actual production secrets to Git.
# - The backend (Render) and frontend (Vercel) require separate environment configurations.
# - Variables prefixed with VITE_ are embedded into the client-side JavaScript bundle.
#   NEVER prefix DATABASE_URL, JWT_SECRET, or GEMINI_API_KEY with VITE_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER BACKEND ENVIRONMENT VARIABLES (Configure in Render Web Service Dashboard)
# ------------------------------------------------------------------------------

# Node Environment ('production' | 'development')
NODE_ENV="production"

# Port on which the HTTP server listens.
# On Render, this is provided automatically by Render runtime (e.g. 10000).
PORT="3000"

# FRONTEND_URL: Allowed CORS origin for the deployed frontend (Vercel).
# Example: https://your-project.vercel.app (or comma-separated list of origins)
# Trailing slashes are automatically trimmed by the backend.
FRONTEND_URL="https://your-finsight-app.vercel.app"

# CORS_ORIGIN: Optional secondary CORS origins (e.g. preview branches or custom domains).
# CORS_ORIGIN="https://preview.your-domain.com,https://app.your-domain.com"

# COOKIE_SAME_SITE: Set to 'none' for cross-site cookie transmission (Vercel frontend -> Render backend).
# Combined with httpOnly: true and secure: true in production.
COOKIE_SAME_SITE="none"

# DATABASE_URL: Neon PostgreSQL pooled connection string (server-side only).
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# JWT_SECRET: Cryptographic secret key for signing session tokens (min 32 characters in production).
# Generate using: openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_random_at_least_32_characters_secret_key"

# GEMINI_API_KEY: Google Gemini API key used server-side for chatbot reasoning and document OCR.
# If omitted or invalid, the chatbot gracefully falls back to the deterministic FinSight Grounded Engine.
# Obtain a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_API_KEY_HERE"

# GEMINI_MODEL: Google Gemini model version used for chatbot reasoning (server-side only).
# Default: "gemini-3.5-flash-lite"
GEMINI_MODEL="gemini-3.5-flash-lite"

# DISABLE_HMR: Set to 'true' in CI/headless environments to disable Vite file watching.
DISABLE_HMR="true"

# ------------------------------------------------------------------------------
# 2. VERCEL FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Project Settings)
# ------------------------------------------------------------------------------

# VITE_API_URL: Public URL of the deployed Render backend API.
# In local development, leave empty or unset to point to the local server (http://localhost:3000).
# In production on Vercel, set to your Render backend service URL.
# Example: https://finsight-api.onrender.com
VITE_API_URL="https://your-finsight-api.onrender.com"
